---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PreguntaAccordion from '../components/PreguntaAccordion.astro';
import Icon from '../components/Icon.astro';
import { LINES } from '../data/lines';

const preguntas = (await getCollection('que-investigamos')).sort((a, b) => a.data.orden - b.data.orden);
const mid  = Math.ceil(preguntas.length / 2);
const colA = preguntas.slice(0, mid);
const colB = preguntas.slice(mid);
---

<Base
  title="¿Qué investigamos en CODEC?"
  description="Preguntas y respuestas de divulgación científica del grupo de investigación CODEC."
>
  <div class="max-w-6xl mx-auto px-6 py-16">
    <div class="max-w-4xl mx-auto mb-12 text-center">
      <h1 class="text-4xl font-extrabold text-gray-900">¿Qué investigamos en CODEC?</h1>
      <p class="text-gray-500 mt-4 text-lg leading-relaxed">
        En CODEC estudiamos cómo pensamos, sentimos y nos comportamos, desde la evolución humana
        hasta la cognición y la neuropsicología. Haz clic en una pregunta y descubre más de lo que hacemos.
      </p>
    </div>

    <!-- TEMPORAL: quitar este bloque (y public/feria-ctei-ii.jpg) cuando termine la feria -->
    <img
      src="/feria-ctei-ii.jpg"
      alt="II Feria CTeI: Ciencia, Tecnología e Innovación, 14 y 15 de septiembre"
      class="w-full max-w-xl mx-auto rounded-2xl shadow-lg mb-12"
    />

    {preguntas.length > 0 ? (
      <>
        <div class="flex flex-wrap justify-center gap-2 mb-8">
          {Object.values(LINES).map(line => (
            <span
              class="inline-flex items-center gap-1.5 text-xs px-2.5 py-1 rounded-full font-medium"
              style={`background-color: ${line.color}18; color: ${line.color}`}
            >
              <span class="w-2 h-2 rounded-full shrink-0" style={`background-color: ${line.color}`}></span>
              {line.id === 'transversal' ? line.name_es : `Línea ${line.id.replace('line', '')} · ${line.name_es}`}
            </span>
          ))}
        </div>
        <div class="grid lg:grid-cols-2 gap-4 items-start">
          <div class="space-y-4">
            {colA.map(p => <PreguntaAccordion pregunta={p} />)}
          </div>
          <div class="space-y-4">
            {colB.map(p => <PreguntaAccordion pregunta={p} />)}
          </div>
        </div>
      </>
    ) : (
      <p class="text-center text-gray-400 italic py-8">Próximamente...</p>
    )}

    <div class="mt-16 pt-12 border-t border-gray-100">
      <h2 class="text-2xl font-bold text-gray-900 mb-6 text-center">Estructura del grupo</h2>
      <button id="organigrama-btn" class="group cursor-zoom-in relative block w-full" aria-label="Ver organigrama a tamaño completo">
        <img
          src="/estructura-grupo.webp"
          alt="Organigrama del grupo CODEC: jerarquía y relación entre laboratorios, semilleros e integrantes"
          class="w-full rounded-2xl border border-gray-100 shadow-sm group-hover:opacity-90 transition-opacity"
        />
        <span class="absolute bottom-4 right-4 inline-flex items-center gap-1.5 text-xs font-medium bg-gray-900/80 group-hover:bg-gray-900 text-white px-3 py-1.5 rounded-full shadow-lg backdrop-blur-sm transition-colors">
          <Icon name="search" class="w-3.5 h-3.5 shrink-0" /> Ampliar
        </span>
      </button>

      <dialog id="organigrama-dialog"
        class="backdrop:bg-black/70 bg-transparent p-0 rounded-2xl shadow-2xl">
        <button id="organigrama-close" aria-label="Cerrar"
          class="absolute top-3 right-3 text-white bg-black/50 hover:bg-black/70 rounded-full w-8 h-8 flex items-center justify-center text-lg leading-none transition-colors">
          ×
        </button>
        <img
          src="/estructura-grupo.webp"
          alt="Organigrama del grupo CODEC: jerarquía y relación entre laboratorios, semilleros e integrantes"
          class="block max-w-[95vw] max-h-[95vh] w-auto h-auto object-contain rounded-2xl"
        />
      </dialog>
    </div>

    <div class="mt-16 text-center">
      <p class="text-gray-500 mb-4 text-sm">¿Tienes curiosidad por algo más?</p>
      <a
        href="/"
        class="inline-flex items-center gap-3 rounded-2xl border border-codec/25 bg-codec/5 hover:bg-codec/10 px-5 py-3 transition-colors"
      >
        <span class="text-sm font-semibold text-codec">Conoce todo el grupo aquí</span>
      </a>
    </div>
  </div>
</Base>

<script>
  const btn    = document.getElementById('organigrama-btn') as HTMLButtonElement;
  const dialog = document.getElementById('organigrama-dialog') as HTMLDialogElement;
  const close  = document.getElementById('organigrama-close') as HTMLButtonElement;
  btn?.addEventListener('click', () => dialog?.showModal());
  close?.addEventListener('click', () => dialog?.close());
  dialog?.addEventListener('click', e => { if (e.target === dialog) dialog.close(); });
</script>
