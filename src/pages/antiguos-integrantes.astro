---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { alumni } from '../data/alumni';

const publications = await getCollection('publications');

function normName(s: string): string {
  return s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().trim();
}

const pubCountBySlug: Record<string, number> = {};
for (const pub of publications) {
  for (const author of pub.data.authors) {
    const a = alumni.find(a => normName(a.name) === normName(author));
    if (a) pubCountBySlug[a.slug] = (pubCountBySlug[a.slug] ?? 0) + 1;
  }
}

function parsePeriod(period: string): { start: number; end: number } {
  const parts = period.split('–');
  const start = parseInt(parts[0]);
  const end   = parts[1] ? parseInt(parts[1]) : start;
  return { start, end };
}

const sortedAlumni = [...alumni].sort((a, b) => {
  const pa = parsePeriod(a.period);
  const pb = parsePeriod(b.period);
  return pb.end !== pa.end ? pb.end - pa.end : pb.start - pa.start;
});

const AXIS_START = 2004;
const AXIS_END   = new Date().getFullYear() + 1; // un año de margen a la derecha
const SPAN       = AXIS_END - AXIS_START;

const TICKS: number[] = [];
for (let y = AXIS_START; y < AXIS_END; y += 4) TICKS.push(y);
---

<Base title="Historia">
  <div class="max-w-5xl mx-auto px-6 py-16">

    <h1 class="text-4xl font-extrabold text-gray-900 mb-4">Historia y antiguos integrantes</h1>

    <div class="prose prose-gray max-w-none mb-12 text-gray-600 leading-relaxed space-y-4">
      <p>
        CODEC fue reconocido por Minciencias en <strong>2004</strong> con el nombre
        <em>Procesos Cognoscitivos y Educación</em>. Con el tiempo, su actividad se orientó cada vez
        más hacia las ciencias cognitivas y del comportamiento, lo que llevó al cambio de nombre actual:
        <strong>Cognición, Comportamiento y Evolución (CODEC)</strong>.
      </p>
      <p>
        A lo largo de más de veinte años han formado parte del grupo investigadores, docentes y
        colaboradores que contribuyeron a construir su historia. Esta página recoge a quienes
        participaron en algún momento y cuyo nombre puede aparecer como coautor en las
        <a href="/publicaciones" class="text-codec hover:underline">publicaciones del grupo</a>.
      </p>
    </div>

    <!-- Timeline -->
    <div class="mt-8">

      <!-- Eje de años -->
      <div class="flex mb-1 select-none">
        <div class="w-2/5 shrink-0"></div>
        <div class="relative flex-1 h-5">
          {TICKS.map((y, i) => (
            <span
              class="absolute text-xs text-gray-400"
              style={`left: ${((y - AXIS_START) / SPAN) * 100}%; transform: translateX(${i === 0 ? '0' : '-50%'})`}
            >
              {y}
            </span>
          ))}
        </div>
      </div>

      <!-- Filas -->
      {sortedAlumni.map(member => {
        const { start, end } = parsePeriod(member.period);
        const barLeft  = ((start - AXIS_START) / SPAN) * 100;
        const barWidth = Math.max(((end + 1 - start) / SPAN) * 100, 1.5);
        const pubs     = pubCountBySlug[member.slug];

        return (
          <div
            id={member.slug}
            class="flex items-center py-1 border-b border-gray-100 group/row"
          >
            <!-- Nombre -->
            <div class="w-2/5 shrink-0 pr-6 flex items-baseline gap-2">
              {member.url ? (
                <a
                  href={member.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-sm text-gray-800 underline underline-offset-2 decoration-gray-300 hover:text-codec hover:decoration-codec transition-colors leading-snug"
                >
                  {member.name}
                </a>
              ) : (
                <span class="text-sm text-gray-800 leading-snug">{member.name}</span>
              )}
              {pubs && (
                <a
                  href={`/publicaciones?autor=${member.slug}&nombre=${encodeURIComponent(member.name)}`}
                  class="text-xs bg-codec text-white shrink-0 tabular-nums px-1.5 py-0.5 rounded font-semibold hover:bg-amber-500 transition-colors"
                  title={`Ver ${pubs} publicación${pubs !== 1 ? 'es' : ''} en CODEC`}
                >
                  {pubs} pub.
                </a>
              )}
            </div>

            <!-- Barra -->
            <div class="relative flex-1 h-7">
              {TICKS.map(y => (
                <div
                  class="absolute inset-y-0 w-px bg-gray-100"
                  style={`left: ${((y - AXIS_START) / SPAN) * 100}%`}
                />
              ))}
              <div
                class="absolute top-2 bottom-2 rounded bg-codec/50 group-hover/row:bg-codec/75 transition-colors"
                style={`left: ${barLeft}%; width: ${barWidth}%`}
                title={member.period}
              />
            </div>
          </div>
        );
      })}

    </div>
  </div>
</Base>
