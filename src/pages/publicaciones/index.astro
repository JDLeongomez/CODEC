---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PublicationCard from '../../components/PublicationCard.astro';
import PublicationsByYear from '../../components/PublicationsByYear.astro';
import CollaborationMap from '../../components/CollaborationMap.astro';
import FieldsOfStudy from '../../components/FieldsOfStudy.astro';
import { alumni } from '../../data/alumni';
import { slug as toSlug } from '../../utils';

function normName(s: string) {
  return s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().trim();
}
const currentResearchers = (await getCollection('researchers')).filter(r => !r.data.draft);
const authorNormToSlug = Object.fromEntries([
  ...alumni.map(a => [normName(a.name), a.slug]),
  ...currentResearchers.map(r => [normName(r.data.name), toSlug(r.id)]),
]);

const publications = (await getCollection('publications'))
  .sort((a, b) => b.data.year - a.data.year || a.data.title.localeCompare(b.data.title));

const byYear: Record<number, typeof publications> = {};
for (const pub of publications) {
  if (!byYear[pub.data.year]) byYear[pub.data.year] = [];
  byYear[pub.data.year].push(pub);
}
const years = Object.keys(byYear).map(Number).sort((a, b) => b - a);

const typeLabels: Record<string, string> = {
  article:        'Artículo',
  'book-chapter': 'Capítulo',
  book:           'Libro',
  conference:     'Conferencia',
  preprint:       'Preprint',
  thesis:         'Tesis',
  software:       'Software',
  other:          'Otro',
};

const presentTypes = [...new Set(publications.map(p => p.data.pub_type))].sort();
---

<Base title="Publicaciones">
  <div class="max-w-4xl mx-auto px-6 py-16">

    <div class="mb-8">
      <h1 class="text-4xl font-extrabold text-gray-900">Publicaciones</h1>
    </div>

    <!-- Estadísticas -->
    <details class="group mb-12">
      <summary
        class="cursor-pointer select-none list-none flex items-center justify-between gap-4 bg-gradient-to-r from-codec/20 to-codec/5 border-2 border-codec/30 rounded-2xl px-6 py-5 shadow-sm hover:border-codec/60 hover:from-codec/25 transition-colors [&::-webkit-details-marker]:hidden"
      >
        <span class="flex items-center gap-4">
          <span class="flex items-center justify-center w-11 h-11 rounded-xl bg-codec text-white shrink-0">
            <svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M3 13.125c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 0 1 3 19.875v-6.75ZM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V8.625ZM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V4.125Z"/>
            </svg>
          </span>
          <span>
            <span class="block text-base font-bold text-amber-900">Estadísticas del grupo</span>
            <span class="block text-xs text-amber-700/80">Producción, colaboraciones internacionales y campos de estudio</span>
          </span>
        </span>
        <svg class="w-5 h-5 text-amber-700 shrink-0 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
        </svg>
      </summary>
      <div class="pt-6 space-y-6">
        <div class="bg-white rounded-2xl border border-gray-100 p-5 shadow-sm">
          <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-4">Producción por año</h2>
          <PublicationsByYear />
        </div>
        <div class="bg-white rounded-2xl border border-gray-100 p-5 shadow-sm">
          <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-4">Campos de estudio</h2>
          <FieldsOfStudy />
        </div>
        <div class="bg-white rounded-2xl border border-gray-100 p-5 shadow-sm">
          <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-4">Colaboraciones internacionales</h2>
          <CollaborationMap />
        </div>
      </div>
    </details>

    <!-- Banner filtro por alumni (se muestra solo con ?autor=) -->
    <div id="autor-banner" class="hidden mb-6 flex items-center gap-3 bg-codec/10 border border-codec/20 text-codec px-4 py-2.5 rounded-xl text-sm font-medium">
      <span>Publicaciones de <strong id="autor-nombre"></strong></span>
      <a href="/publicaciones" class="ml-auto text-xs text-codec/60 hover:text-codec transition-colors">× Ver todas</a>
    </div>

    <!-- Barra de filtros -->
    <div class="mb-10 space-y-3">
      <div class="relative">
        <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M17 11A6 6 0 1 1 5 11a6 6 0 0 1 12 0z"/>
        </svg>
        <input
          id="pub-search"
          type="search"
          placeholder="Buscar por título o autores…"
          class="w-full pl-9 pr-4 py-2 rounded-lg border border-gray-200 text-sm text-gray-700 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-codec/30 focus:border-codec/50 transition"
        />
      </div>

      <div class="flex flex-wrap gap-2 items-center">
        <button data-type-btn="all" class="type-btn px-3 py-1 rounded-full text-xs font-medium transition-colors bg-codec/10 text-codec">
          Todos
        </button>
        {presentTypes.map(type => (
          <button data-type-btn={type} class="type-btn px-3 py-1 rounded-full text-xs font-medium transition-colors text-gray-500 hover:bg-gray-100">
            {typeLabels[type] ?? type}
          </button>
        ))}
        <select id="pub-year" class="ml-auto rounded-lg border border-gray-200 text-sm text-gray-700 px-3 py-1.5 focus:outline-none focus:ring-2 focus:ring-codec/30 focus:border-codec/50 transition">
          <option value="all">Todos los años</option>
          {years.map(y => <option value={y}>{y}</option>)}
        </select>
        <span id="pub-count" class="text-xs text-gray-400">
          {publications.length} publicacion{publications.length !== 1 ? 'es' : ''}
        </span>
      </div>
    </div>

    {publications.length === 0 && (
      <p class="text-gray-400 text-center py-16">No hay publicaciones registradas aún.</p>
    )}

    <p id="no-results" class="hidden text-gray-400 text-center py-16">
      No se encontraron publicaciones con ese criterio.
    </p>

    <div class="space-y-14">
      {years.map(year => (
        <div data-year-section>
          <div class="flex items-center gap-4 mb-5">
            <h2 class="text-2xl font-bold text-gray-900">{year}</h2>
            <div class="flex-1 h-px bg-gray-100"></div>
            <span class="text-sm text-gray-400">
              {byYear[year].length} publicaci{byYear[year].length === 1 ? 'ón' : 'ones'}
            </span>
          </div>
          <div class="space-y-3">
            {byYear[year].map(pub => (
              <div
                data-pub
                data-type={pub.data.pub_type}
                data-year={pub.data.year}
                data-text={`${pub.data.title} ${pub.data.authors.join(' ')}`.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase()}
                data-author-slugs={pub.data.authors.map(a => authorNormToSlug[normName(a)] ?? '').filter(Boolean).join('|')}
              >
                <PublicationCard pub={pub} />
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>

  </div>
</Base>

<script>
  const searchInput  = document.getElementById('pub-search') as HTMLInputElement;
  const yearSelect   = document.getElementById('pub-year') as HTMLSelectElement;
  const countEl      = document.getElementById('pub-count')!;
  const noResults    = document.getElementById('no-results')!;
  const typeBtns     = document.querySelectorAll<HTMLButtonElement>('[data-type-btn]');
  const pubCards     = document.querySelectorAll<HTMLElement>('[data-pub]');
  const yearSections = document.querySelectorAll<HTMLElement>('[data-year-section]');

  let activeType  = 'all';
  let activeYear  = 'all';
  let query       = '';
  let activeAutor = '';

  // Leer ?autor= y ?nombre= de la URL
  const params      = new URLSearchParams(location.search);
  const autorSlug   = params.get('autor') ?? '';
  const autorNombre = params.get('nombre') ?? '';

  if (autorSlug) {
    activeAutor = autorSlug;
    const banner   = document.getElementById('autor-banner')!;
    const nombreEl = document.getElementById('autor-nombre')!;
    banner.classList.remove('hidden');
    nombreEl.textContent = autorNombre || autorSlug;
    // Scroll a la lista de publicaciones
    setTimeout(() => {
      document.querySelector<HTMLElement>('[data-year-section]')
        ?.closest('.space-y-14')
        ?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }, 150);
  }

  function applyFilters() {
    let visible = 0;

    pubCards.forEach(card => {
      const typeMatch  = activeType  === 'all' || card.dataset.type === activeType;
      const yearMatch  = activeYear  === 'all' || card.dataset.year === activeYear;
      const textMatch  = query       === ''    || card.dataset.text!.includes(query);
      const autorMatch = activeAutor === ''    ||
        (card.dataset.authorSlugs ?? '').split('|').includes(activeAutor);
      const show = typeMatch && yearMatch && textMatch && autorMatch;
      card.style.display = show ? '' : 'none';
      if (show) visible++;
    });

    yearSections.forEach(section => {
      const hasVisible = [...section.querySelectorAll<HTMLElement>('[data-pub]')]
        .some(c => c.style.display !== 'none');
      section.style.display = hasVisible ? '' : 'none';
    });

    countEl.textContent = `${visible} publicacion${visible !== 1 ? 'es' : ''}`;
    noResults.classList.toggle('hidden', visible > 0);
  }

  // Aplicar filtro de autor al cargar si viene en la URL
  if (autorSlug) applyFilters();

  searchInput?.addEventListener('input', () => {
    query = searchInput.value.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().trim();
    applyFilters();
  });

  yearSelect?.addEventListener('change', () => {
    activeYear = yearSelect.value;
    applyFilters();
  });

  typeBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      activeType = btn.dataset.typeBtn!;
      typeBtns.forEach(b => {
        const isActive = b.dataset.typeBtn === activeType;
        b.classList.toggle('bg-codec/10', isActive);
        b.classList.toggle('text-codec', isActive);
        b.classList.toggle('text-gray-500', !isActive);
        b.classList.toggle('hover:bg-gray-100', !isActive);
      });
      applyFilters();
    });
  });
</script>
