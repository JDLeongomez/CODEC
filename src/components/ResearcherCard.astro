---
import { getEntry, type CollectionEntry } from 'astro:content';
import { slug } from '../utils';
import { LINES } from '../data/lines';

interface Props {
  researcher: CollectionEntry<'researchers'>;
}

const { researcher } = Astro.props;
const { name, avatar, codec_role, labs, semilleros } = researcher.data;
const roles = (codec_role ?? '').split(',').map(r => r.trim()).filter(Boolean);

const labEntries       = await Promise.all((labs ?? []).map(ref => getEntry(ref)));
const semilleroEntries = await Promise.all((semilleros ?? []).map(ref => getEntry(ref)));

const lineIds = [...new Set([
  ...labEntries.map(l => l?.data.research_line),
  ...semilleroEntries.map(s => s?.data.research_line),
])].filter(Boolean) as string[];

// short_name → href
const entityMap: Record<string, string> = {
  ...Object.fromEntries(labEntries.filter(Boolean).map(l => [l!.data.short_name, `/laboratorios/${slug(l!.id)}`])),
  ...Object.fromEntries(semilleroEntries.filter(Boolean).map(s => [s!.data.short_name, `/semilleros/${slug(s!.id)}`])),
};

type Segment = { text: string; href?: string };
function parseRole(role: string): Segment[] {
  for (const [entityName, href] of Object.entries(entityMap)) {
    const idx = role.indexOf(entityName);
    if (idx !== -1) {
      const parts: Segment[] = [];
      if (idx > 0) parts.push({ text: role.slice(0, idx) });
      parts.push({ text: entityName, href });
      const after = role.slice(idx + entityName.length);
      if (after) parts.push({ text: after });
      return parts;
    }
  }
  return [{ text: role }];
}

const parsedRoles = roles.map(parseRole);
---

<div
  class="group relative bg-white rounded-2xl border border-gray-100 shadow-sm hover:shadow-md transition-all duration-200 overflow-hidden flex flex-col"
>
  <a href={`/investigadores/${slug(researcher.id)}`} class="absolute inset-0" aria-label={name}></a>

  <div class="p-6 flex flex-col items-center text-center flex-1">
    <div class="mb-4">
      <img
        src={avatar}
        alt={name}
        class="w-24 h-24 rounded-full object-cover ring-2 ring-gray-100 group-hover:ring-codec/40 transition-all"
      />
    </div>

    <h3 class="font-semibold text-gray-900 group-hover:text-codec transition-colors leading-tight">
      {name}
    </h3>
    <p class="text-xs text-gray-500 mt-1">{researcher.data.academic_role}</p>

    <div class="flex flex-wrap gap-1 justify-center mt-3">
      {lineIds.map(lid => {
        const line = LINES[lid as keyof typeof LINES];
        return line ? (
          <span
            class="text-xs px-2 py-0.5 rounded-full font-medium"
            style={`background-color: ${line.color}18; color: ${line.color}`}
          >
            {line.name_es}
          </span>
        ) : null;
      })}
    </div>

    {parsedRoles.length > 0 && (
      <ul class="mt-3 space-y-0.5">
        {parsedRoles.map(segments => (
          <li class="text-xs text-gray-500 relative z-10">
            {segments.map(seg =>
              seg.href ? (
                <a
                  href={seg.href}
                  class="font-medium underline underline-offset-2 decoration-gray-300 hover:text-codec hover:decoration-codec transition-colors"
                >
                  {seg.text}
                </a>
              ) : (
                <span>{seg.text}</span>
              )
            )}
          </li>
        ))}
      </ul>
    )}
  </div>
</div>
