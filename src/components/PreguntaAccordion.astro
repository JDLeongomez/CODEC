---
import { getEntry, type CollectionEntry } from 'astro:content';
import { slug } from '../utils';
import { LINES } from '../data/lines';
import Icon from './Icon.astro';
import PreguntaAutores from './PreguntaAutores.astro';

interface Props {
  pregunta: CollectionEntry<'que-investigamos'>;
}

const { pregunta: entry } = Astro.props;
const { pregunta, lab, semillero } = entry.data;

const labEntry       = lab ? await getEntry(lab) : null;
const semilleroEntry = semillero ? await getEntry(semillero) : null;

const grupos: { nombre: string; href: string; color: string; logo?: string }[] = [
  labEntry && {
    nombre: labEntry.data.short_name,
    href: `/laboratorios/${slug(labEntry.id)}`,
    color: labEntry.data.color,
    logo: labEntry.data.logo_light,
  },
  semilleroEntry && {
    nombre: semilleroEntry.data.short_name,
    href: `/semilleros/${slug(semilleroEntry.id)}`,
    color: semilleroEntry.data.color,
    logo: semilleroEntry.data.logo_light,
  },
].filter(Boolean) as { nombre: string; href: string; color: string; logo?: string }[];

const lineaColor = grupos[0]
  ? LINES[(labEntry ?? semilleroEntry)!.data.research_line as keyof typeof LINES]?.color
  : null;

const cardStyle = lineaColor
  ? `border: 1px solid ${lineaColor}35; border-left: 6px solid ${lineaColor}; background: linear-gradient(135deg, ${lineaColor}14, white 60%);`
  : undefined;

const btnColor = lineaColor ?? '#111827';
const btnClass = 'ver-respuesta-btn inline-flex items-center gap-2 text-sm font-semibold px-5 py-2.5 rounded-xl border-2 bg-white transition-colors';
const btnStyle = `--btn-color: ${btnColor}; border-color: ${btnColor}; color: ${btnColor}`;
---

<details
  class={`group rounded-2xl shadow-sm overflow-hidden transition-shadow hover:shadow-md ${lineaColor ? '' : 'bg-white border border-gray-100'}`}
  style={cardStyle}
>
  <summary class="list-none cursor-pointer select-none px-6 py-4 flex items-center justify-between gap-4 hover:bg-black/[0.02] transition-colors [&::-webkit-details-marker]:hidden">
    <span class="font-semibold text-gray-900">{pregunta}</span>
    <svg
      class:list={['w-4 h-4 shrink-0 transition-transform group-open:rotate-180', { 'text-gray-400': !lineaColor }]}
      style={lineaColor ? `color: ${lineaColor}` : undefined}
      fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"
    >
      <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
    </svg>
  </summary>

  <div class="px-6 pb-6 pt-4 border-t border-gray-50">
    <div class="flex justify-center mb-4">
      <a href={`/respuesta/${slug(entry.id)}`} class={btnClass} style={btnStyle}>
        <Icon name="link" class="w-4 h-4 shrink-0" /> Ver respuesta
      </a>
    </div>

    <PreguntaAutores pregunta={entry} />
  </div>
</details>

<style>
  .ver-respuesta-btn:hover {
    background-color: color-mix(in srgb, var(--btn-color) 12%, white);
  }
</style>
