---
import { getEntry, type CollectionEntry } from 'astro:content';
import { slug } from '../utils';
import { LINES } from '../data/lines';
import Icon from './Icon.astro';

interface Props {
  pregunta: CollectionEntry<'preguntas-feria'>;
}

const { pregunta: entry } = Astro.props;
const { pregunta, investigador, auxiliar, lab, semillero, respuesta_url } = entry.data;

const investigadorEntry = investigador ? await getEntry(investigador) : null;
const auxiliarEntry     = auxiliar ? await getEntry(auxiliar) : null;
const autor     = investigadorEntry ?? auxiliarEntry;
const autorHref = investigadorEntry
  ? `/investigadores/${slug(investigadorEntry.id)}`
  : auxiliarEntry
    ? `/auxiliares/${slug(auxiliarEntry.id)}`
    : null;

const labEntry       = lab ? await getEntry(lab) : null;
const semilleroEntry = semillero ? await getEntry(semillero) : null;
const grupoEntry = labEntry ?? semilleroEntry;
const grupoHref  = labEntry
  ? `/laboratorios/${slug(labEntry.id)}`
  : semilleroEntry
    ? `/semilleros/${slug(semilleroEntry.id)}`
    : null;
const grupoLine = grupoEntry ? LINES[grupoEntry.data.research_line as keyof typeof LINES] : null;
---

<details class="group bg-white rounded-2xl border border-gray-100 shadow-sm overflow-hidden">
  <summary class="list-none cursor-pointer select-none px-6 py-4 flex items-center justify-between gap-4 hover:bg-gray-50/70 transition-colors [&::-webkit-details-marker]:hidden">
    <span class="font-semibold text-gray-900">{pregunta}</span>
    <svg class="w-4 h-4 text-gray-400 shrink-0 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
    </svg>
  </summary>

  <div class="px-6 pb-6 pt-1 border-t border-gray-50">
    <div class="flex flex-wrap items-center gap-2 mb-4">
      {autor && autorHref && (
        <a
          href={autorHref}
          class="text-sm font-medium text-gray-700 hover:text-codec underline underline-offset-2 decoration-gray-300 hover:decoration-codec transition-colors"
        >
          {autor.data.name}
        </a>
      )}
      {grupoEntry && grupoHref && grupoLine && (
        <a
          href={grupoHref}
          class="text-xs px-2 py-0.5 rounded-full font-medium hover:opacity-80 transition-opacity"
          style={`background-color: ${grupoLine.color}18; color: ${grupoLine.color}`}
        >
          {grupoEntry.data.short_name}
        </a>
      )}
    </div>

    <a
      href={respuesta_url}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-1.5 text-xs bg-codec/10 hover:bg-codec/20 text-codec px-3 py-1.5 rounded-lg transition-colors font-medium"
    >
      <Icon name="link" class="w-3.5 h-3.5 shrink-0" /> Ver respuesta
    </a>
  </div>
</details>
